# ---------------------------------------------------------------------------
# Work Console API — paste this into Dokploy's Environment tab.
#
# This service points at the Postgres and object storage used by the worker.
# It does not create or migrate them itself unless WC_RUN_MIGRATIONS=true.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------
# Postgres, as an async SQLAlchemy URL. Use the internal host, never localhost.
WC_DATABASE_URL=

# The macOS app sends this as "Authorization: Bearer <token>".
# Put the same value in the app: Settings > VPS > API KEY.
# The API refuses every request if this is empty (it does not fall back to open
# access), so a missing variable can never expose the board.
WC_API_TOKEN=

# Object storage. Compose sets this for local runs; set it explicitly on Dokploy.
WC_STORAGE_PATH=/var/lib/workconsole/objects

# --- Speech to text (runs in your container) -------------------------------
WC_TRANSCRIPTION_PROVIDER=faster_whisper
# tiny.en ~75 MB | base.en ~145 MB | small.en ~480 MB | medium.en ~1.5 GB
# The audio never leaves this machine. base.en is the sweet spot now that the LLM
# is remote and nothing else is competing for memory.
WC_WHISPER_MODEL=base.en
WC_WHISPER_DEVICE=auto
# int8 on CPU; use float16 on a GPU.
WC_WHISPER_COMPUTE_TYPE=int8
WC_WHISPER_LANGUAGE=en
WC_WHISPER_VAD_FILTER=true

# --- LLM --------------------------------------------------------------------
# Gemini. Transcripts and task data are sent to Google; the audio is not — that
# is transcribed locally by Whisper above.
WC_LLM_PROVIDER=gemini
WC_GEMINI_API_KEY=
WC_GEMINI_MODEL=gemini-2.5-flash
WC_LLM_TEMPERATURE=0.1
WC_ANALYSIS_CHUNK_CHARS=12000

# For a fully local stack instead, run the ollama service and use:
# WC_LLM_PROVIDER=ollama
# WC_OLLAMA_MODEL=qwen2.5:0.5b
# WC_LLM_NUM_CTX=4096

# --- Jobs ------------------------------------------------------------------
WC_JOB_POLL_SECONDS=2
WC_JOB_MAX_ATTEMPTS=3
# A job whose worker died is reclaimed after this many seconds.
WC_JOB_LEASE_SECONDS=1800

# --- Agent -----------------------------------------------------------------
WC_AGENT_MAX_ITERATIONS=6
WC_AGENT_ACTION_TTL_SECONDS=900

WC_LOG_LEVEL=info

# Off by default: the interactive schema at /api/docs reveals the API surface.
# WC_ENABLE_DOCS=true

# --- Optional: transcribe with Gemini too ----------------------------------
# Removes Whisper entirely (no model weights, no ffmpeg) but uploads the meeting
# audio to Google. Leave as faster_whisper to keep audio on this machine.
# WC_TRANSCRIPTION_PROVIDER=gemini

# --- Optional: S3 instead of a local directory -----------------------------
# WC_STORAGE_BACKEND=s3
# WC_S3_ENDPOINT=http://minio:9000
# WC_S3_BUCKET=workconsole
# WC_S3_ACCESS_KEY=
# WC_S3_SECRET_KEY=
